# pyenv
#   For a library or app, you might want to share your .python-version if you're
#   using pyenv and micro-managing python versions.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if platform is rather diverse, it may cause problems
#   lesser than/equal to Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# pdm.lock
#   pdm build pack binaries
.pdm-plugins/

